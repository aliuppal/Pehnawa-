{
  "expo": {
    "name": "Pehnawa",
    "slug": "Pehnawa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Pehnawa uses your camera to photograph you and your clothes for outfit ideas and try-on.",
          "photosPermission": "Pehnawa uses your photos so you can add clothes and brand pictures to try on."
        }
      ],
      "expo-font"
    ]
  }
}
